# HACK STORE — env vars (no real secrets required, defaults work offline)
# Payment (mock Razorpay-style). Set to mock test key; bug toggles ignore this.
PAYMENT_PUBLISHABLE_KEY=pk_test_razorpay_mock_12345
PAYMENT_SECRET_KEY=sk_test_mock_12345

# Maps / delivery — free OpenStreetMap Nominatim (no key required)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional weather API (free OpenWeather) — fun touch on confirmation, not required
OPENWEATHER_API_KEY=dummy_or_real_key

# Database — SQLite file path (auto-created & seeded on startup)
DATABASE_PATH=hack_store.db

# Server port (Render uses $PORT)
PORT=8000
